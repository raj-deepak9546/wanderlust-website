<% layout("/layouts/boilerplate.ejs")%>
</head>
<body>
    
    <div class="row mt-3">
        <div class="col-8 offset-2">
           
            <h3>create your new listing</h3>
            
            <form method="POST" action="/listings"  novalidate class="needs-validation" enctype="multipart/form-data">

                <div class="mb-3">
                  <label for="title" class="form-label">Title</label>
                   <input name="listing[title]" placeholder="Add a ctchy Title" type="text" class="form-control" required>
                   <div class="valid-feedback">Title looks goods</div>
                </div>

                <div class="mb-3">
                   <label for="description" class="form-label">Description</label>
                    <textarea name="listing[description]" placeholder="enter description" type="text"  class=" form-control" required></textarea>
                    <div class="invalid-feedback">please enter short description</div>

                </div>

                
                <div class="mb-3">
                  <label for="location" class="form-label">Location</label>
                  <input name="listing[location]" placeholder="Jiapur,rajasthan" type="text" class="form-control">
                  <div class="invalid-feedback">please enter a valid price</div>
                  

                </div>


                <div class="row">
                    <div class="mb-3 col-md-4">
                       <label for="price" class="form-label">price</label>
                       <input name="listing[price]" placeholder="12000" class="form-control" >
                       
            
                    </div>
                    <div class="mb-3 col-md-8">
                        <label for="country" class="form-label" >country</label>
                        <input name="listing[country]" placeholder="india" type="text" class="form-control" required>
                        <div class="invalid-feedback">country name should be valid </div>

                    </div>

                </div>



               

                <div class="mb-3">
                  <label for="image" class="form-label"> Upload Listing image</label>
                  <input name="listing[image][url]"  type="file" class="form-control" required>

                </div>
     
     
     
     
     
                <button class="btn btn-dark add-btn mt-3 ">Add </button>
                <br><br>

            </form>
        </div>
        
    
    </div>
   
    
</body>
